# Copy to .env.local for development

# Rate limiting window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per IP per window (default: 20)
RATE_LIMIT_MAX=20

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Optional: set to 'true' to enable verbose API logging
API_VERBOSE=false
